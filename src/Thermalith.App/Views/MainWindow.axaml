<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Thermalith.App.ViewModels"
        xmlns:ed="clr-namespace:Thermalith.App.ViewModels.Editors"
        xmlns:views="clr-namespace:Thermalith.App.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Thermalith.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/thermalith-256.png"
        Cursor="{Binding Printer.IsBusy, Converter={StaticResource BusyCursor}}"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Grid.frow">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Grid.frow > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="ComboBox.fld">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <!-- macOS top-of-screen menu bar (GitHub #9). A deliberate mirror of the in-window Menu below
         rather than a replacement: only one of the two is ever shown (see the IsVisible switches on
         NativeMenuBar / Menu), so Windows and Linux keep the exact menu they had. Mnemonics are
         dropped here because macOS doesn't use them; accelerators come from the Window's KeyBindings
         (wired in WireKeymap), so shortcuts work either way and Gesture here is display only. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New" Command="{Binding NewCommand}" />
                        <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}" />
                        <NativeMenuItem Header="Open Recent" IsEnabled="{Binding HasRecentFiles}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Save" Command="{Binding SaveCommand}" />
                        <NativeMenuItem Header="Save As…" Command="{Binding SaveAsCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Command="{Binding QuitCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Edit">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Undo" Command="{Binding UndoCommand}" />
                        <NativeMenuItem Header="Redo" Command="{Binding RedoCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Cut" Command="{Binding CutCommand}" />
                        <NativeMenuItem Header="Copy" Command="{Binding CopyCommand}" />
                        <NativeMenuItem Header="Paste" Command="{Binding PasteCommand}" />
                        <NativeMenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="View">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" />
                        <NativeMenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" />
                        <NativeMenuItem Header="Zoom to Fit" Command="{Binding ZoomFitCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Show Grid" ToggleType="CheckBox" IsChecked="{Binding Editor.ShowGrid, Mode=TwoWay}" />
                        <NativeMenuItem Header="Snap to Grid" ToggleType="CheckBox" IsChecked="{Binding Editor.SnapEnabled, Mode=TwoWay}" />
                        <NativeMenuItem Header="Show Printable Area" ToggleType="CheckBox" IsChecked="{Binding Editor.ShowSafeArea, Mode=TwoWay}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Smooth Preview" ToggleType="CheckBox" IsChecked="{Binding Editor.SmoothPreview, Mode=TwoWay}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Theme">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="System (follow OS)" ToggleType="Radio"
                                                    Command="{Binding SetThemeCommand}" CommandParameter="Default"
                                                    IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Default, Mode=OneWay}" />
                                    <NativeMenuItem Header="Light" ToggleType="Radio"
                                                    Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                                    IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Light, Mode=OneWay}" />
                                    <NativeMenuItem Header="Dark" ToggleType="Radio"
                                                    Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                                    IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Dark, Mode=OneWay}" />
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Insert">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Text" Command="{Binding InsertCommand}" CommandParameter="text" />
                        <NativeMenuItem Header="Barcode" Command="{Binding InsertCommand}" CommandParameter="barcode" />
                        <NativeMenuItem Header="QR Code" Command="{Binding InsertCommand}" CommandParameter="qr" />
                        <NativeMenuItem Header="Date / Time" Command="{Binding InsertCommand}" CommandParameter="datetime" />
                        <NativeMenuItem Header="Shape" Command="{Binding InsertCommand}" CommandParameter="shape" />
                        <NativeMenuItem Header="Image" Command="{Binding InsertCommand}" CommandParameter="image" />
                        <NativeMenuItem Header="Clip Art…" Command="{Binding ToggleClipPaletteCommand}" />
                        <NativeMenuItem Header="Table" Command="{Binding InsertCommand}" CommandParameter="table" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Data Merge">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Select Data File…" Command="{Binding DataMerge.SelectFileCommand}" />
                        <NativeMenuItem Header="Clear Data Source" Command="{Binding DataMerge.ClearCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Columns" IsEnabled="{Binding DataMerge.HasData}" />
                        <NativeMenuItem Header="{Binding DataMerge.SourceInfo}" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Preview Merge Data" ToggleType="CheckBox"
                                        IsChecked="{Binding DataMerge.IsPreviewing, Mode=TwoWay}"
                                        IsEnabled="{Binding DataMerge.HasData}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Print Merge…" Command="{Binding DataMerge.PrintMergeCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Arrange">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Group" Command="{Binding GroupCommand}" />
                        <NativeMenuItem Header="Ungroup" Command="{Binding UngroupCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Bring to Front" Command="{Binding BringToFrontCommand}" />
                        <NativeMenuItem Header="Bring Forward" Command="{Binding BringForwardCommand}" />
                        <NativeMenuItem Header="Send Backward" Command="{Binding SendBackwardCommand}" />
                        <NativeMenuItem Header="Send to Back" Command="{Binding SendToBackCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Align">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Left" Command="{Binding AlignLeftCommand}" />
                                    <NativeMenuItem Header="Center" Command="{Binding AlignCenterHCommand}" />
                                    <NativeMenuItem Header="Right" Command="{Binding AlignRightCommand}" />
                                    <NativeMenuItemSeparator />
                                    <NativeMenuItem Header="Top" Command="{Binding AlignTopCommand}" />
                                    <NativeMenuItem Header="Middle" Command="{Binding AlignMiddleVCommand}" />
                                    <NativeMenuItem Header="Bottom" Command="{Binding AlignBottomCommand}" />
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Distribute">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Horizontally" Command="{Binding DistributeHCommand}" />
                                    <NativeMenuItem Header="Vertically" Command="{Binding DistributeVCommand}" />
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Center on Label">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Horizontally" Command="{Binding CenterOnLabelHCommand}" />
                                    <NativeMenuItem Header="Vertically" Command="{Binding CenterOnLabelVCommand}" />
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Printer">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Refresh Ports" Command="{Binding Printer.RefreshPortsCommand}" />
                        <NativeMenuItem Header="Connect" Command="{Binding Printer.ConnectCommand}" />
                        <NativeMenuItem Header="Disconnect" Command="{Binding Printer.DisconnectCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Refresh Status" Command="{Binding Printer.RefreshStatusCommand}" />
                        <NativeMenuItem Header="Change Labels" Command="{Binding Printer.ChangeLabelsCommand}" />
                        <NativeMenuItem Header="Print" Command="{Binding Printer.PrintCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Help">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <!-- Kept even though macOS conventionally hoists About/Quit into the application
                             menu: a duplicate entry is harmless, a missing one strands the user. -->
                        <NativeMenuItem Header="About Thermalith" Command="{Binding AboutCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Connection Logging" ToggleType="CheckBox"
                                        IsChecked="{Binding ConnectionLogging, Mode=TwoWay}" />
                        <NativeMenuItem Header="Open Log Folder…" Command="{Binding OpenLogFolderCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <Border DockPanel.Dock="Top" IsVisible="{Binding Editor.IsBlockSource}" Background="#2244CCCC" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Shared custom block - changes affect all referencing designs" VerticalAlignment="Center" />
                <Button Content="Unlock for editing..." IsVisible="{Binding Editor.IsBlockReadOnly}" Command="{Binding UnlockCustomBlockCommand}" />
                <TextBlock Text="Unlocked for shared editing" IsVisible="{Binding Editor.BlockSourceUnlocked}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" IsVisible="{Binding Editor.IsEditingBlock}" Background="#3355BBBB" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Editing shared block in place" VerticalAlignment="Center" />
                <Button Content="Save block changes" Command="{Binding SaveBlockChangesCommand}" />
                <Button Content="Cancel block editing" Command="{Binding CancelBlockChangesCommand}" />
            </StackPanel>
        </Border>


        <!-- Exports the NativeMenu above to the system menu bar. Renders nothing itself; on
             Windows/Linux it stays collapsed and the in-window Menu below is used instead. -->
        <NativeMenuBar DockPanel.Dock="Top" IsVisible="{OnPlatform false, macOS=true}" />

        <!-- Menu (§7.1) -->
        <Menu DockPanel.Dock="Top" IsVisible="{OnPlatform true, macOS=false}">
            <MenuItem Header="_File">
                <MenuItem Name="MiNew" Header="_New" Command="{Binding NewCommand}" />
                <MenuItem Name="MiOpen" Header="_Open…" Command="{Binding OpenCommand}" />
                <MenuItem Name="MiRecent" Header="Open _Recent" IsEnabled="{Binding HasRecentFiles}" />
                <MenuItem Header="_Collections..." Click="OnCollections" />
                <Separator />
                <MenuItem Name="MiSave" Header="_Save" Command="{Binding SaveCommand}" />
                <MenuItem Name="MiSaveAs" Header="Save _As…" Command="{Binding SaveAsCommand}" />
                <MenuItem Header="Save as custom block..." Command="{Binding SaveAsCustomBlockCommand}" />
                <Separator />
                <MenuItem Header="Print pre_view…" Click="OnPrintPreview" IsEnabled="{Binding !Printer.IsPrinting}" />
                <Separator />
                <MenuItem Name="MiQuit" Header="_Quit" Command="{Binding QuitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit" IsEnabled="{Binding !Editor.IsBlockReadOnly}">
                <MenuItem Name="MiUndo" Header="_Undo" Command="{Binding UndoCommand}" />
                <MenuItem Name="MiRedo" Header="_Redo" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Name="MiCut" Header="Cu_t" Command="{Binding CutCommand}" />
                <MenuItem Name="MiCopy" Header="_Copy" Command="{Binding CopyCommand}" />
                <MenuItem Name="MiPaste" Header="_Paste" Command="{Binding PasteCommand}" />
                <MenuItem Name="MiDuplicate" Header="Du_plicate" Command="{Binding DuplicateCommand}" />
                <Separator />
                <MenuItem Name="MiDelete" Header="_Delete" Command="{Binding DeleteCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Name="MiZoomIn" Header="Zoom _In" Command="{Binding ZoomInCommand}" />
                <MenuItem Name="MiZoomOut" Header="Zoom _Out" Command="{Binding ZoomOutCommand}" />
                <MenuItem Name="MiZoomFit" Header="Zoom to _Fit" Command="{Binding ZoomFitCommand}" />
                <Separator />
                <MenuItem Header="Workspace _Print View" ToggleType="CheckBox" IsChecked="{Binding Editor.IsPrintView, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="Show _Grid" ToggleType="CheckBox" IsChecked="{Binding Editor.ShowGrid, Mode=TwoWay}" />
                <MenuItem Header="Smart snap to _elements" ToggleType="CheckBox" IsChecked="{Binding Editor.SmartSnapEnabled, Mode=TwoWay}" ToolTip.Tip="Snap edges, centres and equal whitespace while dragging. Hold Alt to bypass." />
                <MenuItem Header="_Snap to Grid" ToggleType="CheckBox" IsChecked="{Binding Editor.SnapEnabled, Mode=TwoWay}" />
                <MenuItem Header="Show _Printable Area" ToggleType="CheckBox" IsChecked="{Binding Editor.ShowSafeArea, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="S_mooth Preview" ToggleType="CheckBox" IsChecked="{Binding Editor.SmoothPreview, Mode=TwoWay}"
                          ToolTip.Tip="Show the smooth grayscale preview (anti-aliased) instead of the exact 1-bit print raster" />
                <Separator />
                <MenuItem Header="_Theme">
                    <MenuItem Header="_System (follow OS)" ToggleType="Radio" GroupName="theme"
                              Command="{Binding SetThemeCommand}" CommandParameter="Default"
                              IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Default, Mode=OneWay}" />
                    <MenuItem Header="_Light" ToggleType="Radio" GroupName="theme"
                              Command="{Binding SetThemeCommand}" CommandParameter="Light"
                              IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Light, Mode=OneWay}" />
                    <MenuItem Header="_Dark" ToggleType="Radio" GroupName="theme"
                              Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                              IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Dark, Mode=OneWay}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Insert" IsEnabled="{Binding !Editor.IsBlockReadOnly}">
                <MenuItem Header="Custom block..." Click="OnCustomBlocks" />
                <MenuItem Header="_Text" Command="{Binding InsertCommand}" CommandParameter="text" />
                <MenuItem Header="_Barcode" Command="{Binding InsertCommand}" CommandParameter="barcode" />
                <MenuItem Header="_QR Code" Command="{Binding InsertCommand}" CommandParameter="qr" />
                <MenuItem Header="_Date / Time" Command="{Binding InsertCommand}" CommandParameter="datetime" />
                <MenuItem Header="S_hape" Command="{Binding InsertCommand}" CommandParameter="shape" />
                <MenuItem Header="_Image" Command="{Binding InsertCommand}" CommandParameter="image" />
                <MenuItem Header="Clip _Art…" Command="{Binding ToggleClipPaletteCommand}"
                          ToolTip.Tip="Open the clip-art palette" />
                <MenuItem Header="Ta_ble" Command="{Binding InsertCommand}" CommandParameter="table" />
            </MenuItem>
            <MenuItem Header="_Parameters" SubmenuOpened="OnParametersOpened">
                <MenuItem Header="Show parameter _references" ToggleType="CheckBox" IsChecked="{Binding Editor.ShowParameterReferences, Mode=TwoWay}" ToolTip.Tip="Toggle text between parameter references and next values. QR and barcode symbols always encode actual values." />
                <Separator />
                <MenuItem Header="_Manage parameters…" Click="OnManageParameters" />
                <MenuItem x:Name="MiParameterReferences" Header="_Insert reference" />
            </MenuItem>
            <MenuItem Header="_Data Merge">
                <MenuItem Header="_Select Data File…" Command="{Binding DataMerge.SelectFileCommand}" />
                <MenuItem Header="_Clear Data Source" Command="{Binding DataMerge.ClearCommand}" />
                <Separator />
                <MenuItem Header="_Columns" Name="MiMergeColumns" IsEnabled="{Binding DataMerge.HasData}"
                          ToolTip.Tip="Click a text field, then a column here to insert its token" />
                <MenuItem Header="{Binding DataMerge.SourceInfo}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Pre_view Merge Data" ToggleType="CheckBox"
                          IsChecked="{Binding DataMerge.IsPreviewing, Mode=TwoWay}"
                          IsEnabled="{Binding DataMerge.HasData}"
                          ToolTip.Tip="Show real data on the canvas and step through rows" />
                <Separator />
                <MenuItem Header="_Print Merge…" Command="{Binding DataMerge.PrintMergeCommand}" />
            </MenuItem>
            <MenuItem Header="_Arrange" IsEnabled="{Binding !Editor.IsBlockReadOnly}">
                <MenuItem Name="MiGroup" Header="_Group" Command="{Binding GroupCommand}" />
                <MenuItem Name="MiUngroup" Header="_Ungroup" Command="{Binding UngroupCommand}" />
                <Separator />
                <MenuItem Header="Bring to _Front" Command="{Binding BringToFrontCommand}" />
                <MenuItem Header="Bring _Forward" Command="{Binding BringForwardCommand}" />
                <MenuItem Header="Send _Backward" Command="{Binding SendBackwardCommand}" />
                <MenuItem Header="Send to _Back" Command="{Binding SendToBackCommand}" />
                <Separator />
                <MenuItem Header="_Align">
                    <MenuItem Header="Left" Command="{Binding AlignLeftCommand}" />
                    <MenuItem Header="Center" Command="{Binding AlignCenterHCommand}" />
                    <MenuItem Header="Right" Command="{Binding AlignRightCommand}" />
                    <Separator />
                    <MenuItem Header="Top" Command="{Binding AlignTopCommand}" />
                    <MenuItem Header="Middle" Command="{Binding AlignMiddleVCommand}" />
                    <MenuItem Header="Bottom" Command="{Binding AlignBottomCommand}" />
                </MenuItem>
                <MenuItem Header="_Distribute">
                    <MenuItem Header="Horizontally" Command="{Binding DistributeHCommand}" />
                    <MenuItem Header="Vertically" Command="{Binding DistributeVCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Center on _Label">
                    <MenuItem Header="_Horizontally" Command="{Binding CenterOnLabelHCommand}" />
                    <MenuItem Header="_Vertically" Command="{Binding CenterOnLabelVCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Printer">
                <MenuItem Header="_Refresh Ports" Command="{Binding Printer.RefreshPortsCommand}" />
                <MenuItem Header="_Connect" Command="{Binding Printer.ConnectCommand}" />
                <MenuItem Header="_Disconnect" Command="{Binding Printer.DisconnectCommand}" />
                <Separator />
                <MenuItem Header="Refresh _Status" Command="{Binding Printer.RefreshStatusCommand}" />
                <MenuItem Header="Change _Labels" Command="{Binding Printer.ChangeLabelsCommand}" />
                <MenuItem Header="_Print" Command="{Binding Printer.PrintCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Thermalith" Command="{Binding AboutCommand}" />
                <Separator />
                <MenuItem Header="_Connection Logging" ToggleType="CheckBox"
                          IsChecked="{Binding ConnectionLogging, Mode=TwoWay}"
                          ToolTip.Tip="Record printer connection details to a log file for troubleshooting" />
                <MenuItem Header="Open _Log Folder…" Command="{Binding OpenLogFolderCommand}" />
            </MenuItem>
        </Menu>

        <!-- Standard command toolbar; scrollable command groups retain access at smaller widths. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBar}" BorderBrush="{DynamicResource DividerWeak}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Classes="tool" Command="{Binding NewCommand}" ToolTip.Tip="New label (Ctrl+N)" AutomationProperties.Name="New label"><mi:MaterialIcon Kind="FileOutline" /></Button>
                        <Button Classes="tool" Command="{Binding OpenCommand}" ToolTip.Tip="Open label (Ctrl+O)" AutomationProperties.Name="Open label"><mi:MaterialIcon Kind="FolderOpen" /></Button>
                        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save label (Ctrl+S)" AutomationProperties.Name="Save label"><mi:MaterialIcon Kind="ContentSave" /></Button>
                        <Rectangle Classes="toolDivider" />
                        <Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><mi:MaterialIcon Kind="Undo" /></Button>
                        <Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><mi:MaterialIcon Kind="Redo" /></Button>
                        <Rectangle Classes="toolDivider" />
                        <Button Classes="tool" Command="{Binding CutCommand}" ToolTip.Tip="Cut (Ctrl+X)" AutomationProperties.Name="Cut"><mi:MaterialIcon Kind="ContentCut" /></Button>
                        <Button Classes="tool" Command="{Binding CopyCommand}" ToolTip.Tip="Copy (Ctrl+C)" AutomationProperties.Name="Copy"><mi:MaterialIcon Kind="ContentCopy" /></Button>
                        <Button Classes="tool" Command="{Binding PasteCommand}" ToolTip.Tip="Paste (Ctrl+V)" AutomationProperties.Name="Paste"><mi:MaterialIcon Kind="ContentPaste" /></Button>
                        <Button Classes="tool" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete selection (Delete)" AutomationProperties.Name="Delete selection"><mi:MaterialIcon Kind="DeleteOutline" /></Button>
                        <Rectangle Classes="toolDivider" />
                        <Button Classes="tool" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out"><mi:MaterialIcon Kind="MagnifyMinusOutline" /></Button>
                        <Button Classes="tool" Command="{Binding ZoomFitCommand}" ToolTip.Tip="Fit label to window" AutomationProperties.Name="Fit label to window"><mi:MaterialIcon Kind="ArrowExpandAll" /></Button>
                        <Button Classes="tool" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in"><mi:MaterialIcon Kind="MagnifyPlusOutline" /></Button>
                        <Rectangle Classes="toolDivider" />
                        <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="tool" Command="{Binding RotateLeftCommand}" ToolTip.Tip="Rotate label left 90°" AutomationProperties.Name="Rotate left"><mi:MaterialIcon Kind="RotateLeft" /></Button>
                        <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="tool" Command="{Binding RotateRightCommand}" ToolTip.Tip="Rotate label right 90°" AutomationProperties.Name="Rotate right"><mi:MaterialIcon Kind="RotateRight" /></Button>
                        <Rectangle Classes="toolDivider" />
                        <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="tool" Click="OnManageParameters" ToolTip.Tip="Manage label parameters" AutomationProperties.Name="Manage parameters"><mi:MaterialIcon Kind="FunctionVariant" /></Button>
                        <ToggleButton Classes="tool" IsChecked="{Binding Editor.ShowParameterReferences, Mode=TwoWay}" ToolTip.Tip="Show parameter IDs instead of values" AutomationProperties.Name="Show parameter references"><mi:MaterialIcon Kind="CodeBraces" /></ToggleButton>
                        <Rectangle Classes="toolDivider" />
                        <ComboBox Width="140" VerticalAlignment="Center" SelectedIndex="{Binding Editor.WorkspaceViewIndex, Mode=TwoWay}" ToolTip.Tip="Switch workspace view" AutomationProperties.Name="Workspace view">
                            <ComboBoxItem Content="Design View" />
                            <ComboBoxItem Content="Print View" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Printer.IsConnected, Converter={StaticResource ConnDot}}" />
                    <TextBlock Text="{Binding Printer.LoadedRollText}" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Printer.LoadedRollText}" />                    <Button Classes="tool" Click="OnPrintPreview" IsEnabled="{Binding !Printer.IsPrinting}" ToolTip.Tip="Print preview" AutomationProperties.Name="Print preview"><mi:MaterialIcon Kind="FileFindOutline" /></Button>
                    <Button x:Name="PrintButton" Command="{Binding Printer.PrintButtonCommand}" Classes="accent" ToolTip.Tip="{Binding Printer.PrintButtonText}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <mi:MaterialIcon Kind="Printer" IsVisible="{Binding !Printer.IsPrinting}" />
                            <mi:MaterialIcon Kind="StopCircleOutline" IsVisible="{Binding Printer.IsPrinting}" />
                            <TextBlock Text="{Binding Printer.PrintButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding AboutCommand}" ToolTip.Tip="About Thermalith" AutomationProperties.Name="About Thermalith"><mi:MaterialIcon Kind="InformationOutline" /></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfacePanel}" Padding="10,5" BorderBrush="{DynamicResource DividerWeak}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="tool" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align left (select at least two elements)" AutomationProperties.Name="Align left"><mi:MaterialIcon Kind="AlignHorizontalLeft" /></Button>
                    <Button Classes="tool" Command="{Binding AlignCenterHCommand}" ToolTip.Tip="Align horizontal centers (select at least two elements)" AutomationProperties.Name="Align horizontal centers"><mi:MaterialIcon Kind="AlignHorizontalCenter" /></Button>
                    <Button Classes="tool" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align right (select at least two elements)" AutomationProperties.Name="Align right"><mi:MaterialIcon Kind="AlignHorizontalRight" /></Button>
                    <Button Classes="tool" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align top (select at least two elements)" AutomationProperties.Name="Align top"><mi:MaterialIcon Kind="AlignVerticalTop" /></Button>
                    <Button Classes="tool" Command="{Binding AlignMiddleVCommand}" ToolTip.Tip="Align vertical centers (select at least two elements)" AutomationProperties.Name="Align vertical centers"><mi:MaterialIcon Kind="AlignVerticalCenter" /></Button>
                    <Button Classes="tool" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align bottom (select at least two elements)" AutomationProperties.Name="Align bottom"><mi:MaterialIcon Kind="AlignVerticalBottom" /></Button>
                    <Rectangle Classes="toolDivider" />
                    <Button Classes="tool" Command="{Binding GroupCommand}" ToolTip.Tip="Group selection" AutomationProperties.Name="Group selection"><mi:MaterialIcon Kind="Group" /></Button>
                    <Button Classes="tool" Command="{Binding UngroupCommand}" ToolTip.Tip="Ungroup selection" AutomationProperties.Name="Ungroup selection"><mi:MaterialIcon Kind="Ungroup" /></Button>
                    <Rectangle Classes="toolDivider" />
                    <TextBlock Text="ƒ Parameter-linked elements" Foreground="#22A9AE" Classes="toolbarLabel" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBar}" Padding="8,3">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding Editor.StatusText}" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource TextInfo}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Editor.DocumentStateText}" Foreground="{DynamicResource TextHint}" />
            </Grid>
        </Border>

        <!-- Five-region body: layers | canvas | inspector -->
        <Grid x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: insert palette + layers -->
            <DockPanel Grid.Column="0" Background="{DynamicResource SurfacePanel}">
                <TextBlock DockPanel.Dock="Top" Text="Insert" Margin="8,6,8,2" FontWeight="Bold" Foreground="{DynamicResource TextStrong}" />
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="text">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="FormatText" /><TextBlock Text="Text" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="barcode">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Barcode" /><TextBlock Text="Barcode" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="qr">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Qrcode" /><TextBlock Text="QR Code" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="datetime">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="CalendarClock" /><TextBlock Text="Date / Time" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="shape">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ShapeOutline" /><TextBlock Text="Shape" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="line">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="VectorLine" Width="15" Height="15" Foreground="{DynamicResource IconStroke}" /><TextBlock Text="Line" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="image">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ImageOutline" /><TextBlock Text="Image" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Name="ClipArtButton" Command="{Binding ToggleClipPaletteCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Sticker" Width="15" Height="15" Foreground="{DynamicResource IconStroke}" /><TextBlock Text="Clip Art" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Popup IsOpen="{Binding ClipPaletteOpen}" PlacementTarget="{Binding #ClipArtButton}"
                           Placement="Right" HorizontalOffset="6" IsLightDismissEnabled="False">
                        <views:ClipPalette DataContext="{Binding ClipPalette}" />
                    </Popup>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Command="{Binding InsertCommand}" CommandParameter="table">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Table" /><TextBlock Text="Table" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding !Editor.IsBlockReadOnly}" Classes="insert" Click="OnCustomBlocks" AutomationProperties.Name="Insert custom block" ToolTip.Tip="Browse the custom block library and insert a linked block">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ViewModule" /><TextBlock Text="Custom block" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Elements" Margin="8,2" FontWeight="Bold" Foreground="{DynamicResource TextStrong}" />
                <ListBox IsEnabled="{Binding !Editor.IsBlockReadOnly}" ItemsSource="{Binding Editor.Layers}" SelectedItem="{Binding Editor.SelectedLayer}"
                         SelectionChanged="OnElementsListSelectionChanged"
                         PointerPressed="OnElementsListPointerPressed">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayerItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Text="⛓" FontSize="11" Margin="0,0,4,0" Foreground="#E0A030"
                                           VerticalAlignment="Center" IsVisible="{Binding IsGrouped}" ToolTip.Tip="Grouped" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Foreground="{DynamicResource TextHint}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ToggleButton Grid.Column="3" Classes="listicon" ToolTip.Tip="Visible" IsChecked="{Binding Visible}">
                                    <Panel>
                                        <mi:MaterialIcon Kind="Eye" IsVisible="{Binding Visible}" />
                                        <mi:MaterialIcon Kind="EyeOffOutline" IsVisible="{Binding !Visible}" />
                                    </Panel>
                                </ToggleButton>
                                <ToggleButton Grid.Column="4" Classes="listicon" ToolTip.Tip="Locked" IsChecked="{Binding Locked}">
                                    <Panel>
                                        <mi:MaterialIcon Kind="Lock" IsVisible="{Binding Locked}" />
                                        <mi:MaterialIcon Kind="LockOpenVariantOutline" IsVisible="{Binding !Locked}" />
                                    </Panel>
                                </ToggleButton>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource SurfaceSplitter}" />

            <!-- CENTER: WYSIWYG canvas, framed by mm rulers (top + left) kept in sync with zoom/scroll. -->
            <Grid Grid.Column="2" RowDefinitions="20,*" ColumnDefinitions="26,*">
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfacePanel}" />
                <views:Ruler Grid.Row="0" Grid.Column="1" x:Name="TopRuler" Orientation="Horizontal" />
                <views:Ruler Grid.Row="1" Grid.Column="0" x:Name="LeftRuler" Orientation="Vertical" />
                <ScrollViewer IsEnabled="{Binding !Editor.IsBlockReadOnly}" Grid.Row="1" Grid.Column="1" x:Name="CanvasScroll" Background="{DynamicResource SurfaceCanvas}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PointerPressed="OnCanvasBackgroundPressed">
                <Border Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel Name="CanvasHost" Focusable="True"
                           Width="{Binding Editor.DisplayWidth}" Height="{Binding Editor.DisplayHeight}"
                           Background="Transparent"
                           PointerPressed="OnCanvasPressed" PointerMoved="OnCanvasMoved" PointerReleased="OnCanvasReleased"
                           PointerWheelChanged="OnCanvasWheel" DoubleTapped="OnCanvasDoubleTapped">
                        <Panel.ContextMenu>
                            <ContextMenu>
                                <!-- Element ops (hidden while editing table cells). -->
                                <MenuItem Header="Cut" Command="{Binding CutCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Copy" Command="{Binding CopyCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Paste" Command="{Binding PasteCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <Separator IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Lock / Unlock" Command="{Binding ToggleLockCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Show / Hide" Command="{Binding ToggleVisibleCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <Separator IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Bring to Front" Command="{Binding BringToFrontCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Bring Forward" Command="{Binding BringForwardCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Send Backward" Command="{Binding SendBackwardCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Send to Back" Command="{Binding SendToBackCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <Separator IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Group" Command="{Binding GroupCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Ungroup" Command="{Binding UngroupCommand}" IsVisible="{Binding !Editor.InCellMode}" />
                                <MenuItem Header="Align" IsVisible="{Binding !Editor.InCellMode}">
                                    <MenuItem Header="Left" Command="{Binding AlignLeftCommand}" />
                                    <MenuItem Header="Center" Command="{Binding AlignCenterHCommand}" />
                                    <MenuItem Header="Right" Command="{Binding AlignRightCommand}" />
                                    <Separator />
                                    <MenuItem Header="Top" Command="{Binding AlignTopCommand}" />
                                    <MenuItem Header="Middle" Command="{Binding AlignMiddleVCommand}" />
                                    <MenuItem Header="Bottom" Command="{Binding AlignBottomCommand}" />
                                </MenuItem>
                                <MenuItem Header="Center on Label" IsVisible="{Binding !Editor.InCellMode}">
                                    <MenuItem Header="Horizontally" Command="{Binding CenterOnLabelHCommand}" />
                                    <MenuItem Header="Vertically" Command="{Binding CenterOnLabelVCommand}" />
                                </MenuItem>

                                <!-- Table cell ops (shown while editing table cells). -->
                                <MenuItem Header="Merge Cells" Command="{Binding CellMergeCommand}" IsVisible="{Binding Editor.InCellMode}" />
                                <MenuItem Header="Unmerge" Command="{Binding CellUnmergeCommand}" IsVisible="{Binding Editor.InCellMode}" />
                                <Separator IsVisible="{Binding Editor.InCellMode}" />
                                <MenuItem Header="Fill" IsVisible="{Binding Editor.InCellMode}">
                                    <MenuItem Header="None" Command="{Binding CellFillCommand}" CommandParameter="0" />
                                    <MenuItem Header="25%" Command="{Binding CellFillCommand}" CommandParameter="25" />
                                    <MenuItem Header="50%" Command="{Binding CellFillCommand}" CommandParameter="50" />
                                    <MenuItem Header="75%" Command="{Binding CellFillCommand}" CommandParameter="75" />
                                    <MenuItem Header="100%" Command="{Binding CellFillCommand}" CommandParameter="100" />
                                </MenuItem>
                                <MenuItem Header="Text Colour" IsVisible="{Binding Editor.InCellMode}">
                                    <MenuItem Header="Black" Command="{Binding CellTextBlackCommand}" />
                                    <MenuItem Header="White" Command="{Binding CellTextWhiteCommand}" />
                                </MenuItem>
                                <MenuItem Header="Bold" Command="{Binding CellBoldCommand}" IsVisible="{Binding Editor.InCellMode}" />
                                <MenuItem Header="Italic" Command="{Binding CellItalicCommand}" IsVisible="{Binding Editor.InCellMode}" />
                                <MenuItem Header="Align" IsVisible="{Binding Editor.InCellMode}">
                                    <MenuItem Header="Left" Command="{Binding CellAlignHCommand}" CommandParameter="left" />
                                    <MenuItem Header="Center" Command="{Binding CellAlignHCommand}" CommandParameter="center" />
                                    <MenuItem Header="Right" Command="{Binding CellAlignHCommand}" CommandParameter="right" />
                                    <Separator />
                                    <MenuItem Header="Top" Command="{Binding CellAlignVCommand}" CommandParameter="top" />
                                    <MenuItem Header="Middle" Command="{Binding CellAlignVCommand}" CommandParameter="middle" />
                                    <MenuItem Header="Bottom" Command="{Binding CellAlignVCommand}" CommandParameter="bottom" />
                                </MenuItem>
                                <Separator IsVisible="{Binding Editor.InCellMode}" />
                                <MenuItem Header="Header Row" Command="{Binding CellHeaderRowCommand}" IsVisible="{Binding Editor.InCellMode}" />
                                <MenuItem Header="Header Column" Command="{Binding CellHeaderColumnCommand}" IsVisible="{Binding Editor.InCellMode}" />
                            </ContextMenu>
                        </Panel.ContextMenu>
                        <Path Data="{Binding Editor.LabelOutlineGeometry}" Fill="White" IsHitTestVisible="False" />
                        <Image x:Name="LabelPreviewImage" Source="{Binding Editor.Preview}" Stretch="Fill"
                               Clip="{Binding Editor.LabelOutlineGeometry}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Path Data="{Binding Editor.LabelOutlineGeometry}" Stroke="#888888" StrokeThickness="1" IsHitTestVisible="False" />
                        <Path Data="{Binding Editor.PrintableOutlineGeometry}" Stroke="#E6972A" StrokeThickness="1"
                              StrokeDashArray="4,3" IsVisible="{Binding Editor.ShowWorkspaceGuides}" IsHitTestVisible="False"
                              Clip="{Binding Editor.LabelOutlineGeometry}" />
                        <views:GridOverlay Spacing="{Binding Editor.GridSpacingDisplay}"
                                           IsVisible="{Binding Editor.ShowWorkspaceGrid}" Clip="{Binding Editor.LabelOutlineGeometry}" />
                        <!-- Print-area boundary is now drawn as full-span lines by PrintGuideOverlay
                             (over the whole viewport), not a box hugging the label. -->
                        <Canvas>
                            <Rectangle Name="Marquee" Stroke="#2D7DF6" StrokeThickness="1" StrokeDashArray="2,2"
                                       Fill="#202D7DF6" IsVisible="False" IsHitTestVisible="False" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Editor.SelectionRects}"
                                      IsVisible="{Binding Editor.HasSelection}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:SelRect">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelRect">
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                               Stroke="{Binding Locked, Converter={StaticResource LockStroke}}"
                                               StrokeThickness="1.5" StrokeDashArray="3,2">
                                        <Rectangle.RenderTransform>
                                            <RotateTransform Angle="{Binding Angle}" CenterX="{Binding CenterX}" CenterY="{Binding CenterY}" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Editor.SelectionHandles}"
                                      IsVisible="{Binding Editor.HasSelection}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:HandleSpec">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HandleSpec">
                                    <Rectangle Width="{Binding Size}" Height="{Binding Size}"
                                               Fill="White" Stroke="#2D7DF6" StrokeThickness="1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Nonprinting cell guides for tables whose printed line width is zero. -->
                        <ItemsControl ItemsSource="{Binding Editor.TableGuides}" IsVisible="{Binding !Editor.IsPrintView}" IsHitTestVisible="False" Clip="{Binding Editor.LabelOutlineGeometry}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:SelRect">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelRect">
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="#888888" StrokeThickness="0.7" StrokeDashArray="1,3">
                                        <Rectangle.RenderTransform><RotateTransform Angle="{Binding Angle}" CenterX="{Binding CenterX}" CenterY="{Binding CenterY}" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>                        <ItemsControl ItemsSource="{Binding Editor.SmartGuides}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SmartGuide">
                                    <Line StartPoint="{Binding Start}" EndPoint="{Binding End}" Stroke="#ED56B4" StrokeThickness="1" StrokeDashArray="4,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>                        <ItemsControl ItemsSource="{Binding Editor.SpacingGuides}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpacingGuideVisual">
                                    <Canvas>
                                        <Line StartPoint="{Binding Start}" EndPoint="{Binding End}" Stroke="#008B98" StrokeThickness="1" />
                                        <Line StartPoint="{Binding TickAStart}" EndPoint="{Binding TickAEnd}" Stroke="#008B98" StrokeThickness="1" />
                                        <Line StartPoint="{Binding TickBStart}" EndPoint="{Binding TickBEnd}" Stroke="#008B98" StrokeThickness="1" />
                                        <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Background="#EFFFFFFF" CornerRadius="3" Padding="3,1">
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#006B76" />
                                        </Border>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>                        <!-- Editor-only parameter marks; never included in the print raster. -->
                        <ItemsControl ItemsSource="{Binding Editor.ParameterCues}" IsVisible="{Binding !Editor.IsPrintView}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:ParameterCue">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ParameterCue">
                                    <Panel Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="50%,50%">
                                        <Panel.RenderTransform><RotateTransform Angle="{Binding Angle}" /></Panel.RenderTransform>
                                        <Rectangle Stroke="#008F95" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Border Background="#E0006C70" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-20,0,0">
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" />
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>                        <!-- Edit-mode indicator: distinct accent frame around the whole table. -->
                        <Canvas IsVisible="{Binding Editor.InCellMode}" IsHitTestVisible="False">
                            <Rectangle Canvas.Left="{Binding Editor.CellModeFrame.X}" Canvas.Top="{Binding Editor.CellModeFrame.Y}"
                                       Width="{Binding Editor.CellModeFrame.Width}" Height="{Binding Editor.CellModeFrame.Height}"
                                       Stroke="#2D7DF6" StrokeThickness="2.5" />
                        </Canvas>
                        <!-- Table cell-edit mode: highlight for the selected cell block. -->
                        <ItemsControl ItemsSource="{Binding Editor.CellHighlights}"
                                      IsVisible="{Binding Editor.InCellMode}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:SelRect">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelRect">
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                               Fill="#332D7DF6" Stroke="#2D7DF6" StrokeThickness="1.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- In-place cell editor (shown over the active cell while editing). -->
                        <Canvas IsHitTestVisible="{Binding Editor.IsCellEditing}">
                            <TextBox x:Name="CellEditor" IsVisible="{Binding Editor.IsCellEditing}"
                                     Canvas.Left="{Binding Editor.CellEditorRect.X}" Canvas.Top="{Binding Editor.CellEditorRect.Y}"
                                     Width="{Binding Editor.CellEditorRect.Width}" Height="{Binding Editor.CellEditorRect.Height}"
                                     MinHeight="0" Padding="2,0" FontSize="{Binding Editor.CellTypography.FontSize}"
                                     FontFamily="{Binding Editor.CellTypography.FontFamily}"
                                     FontWeight="{Binding Editor.CellTypography.FontWeight}"
                                     FontStyle="{Binding Editor.CellTypography.FontStyle}"
                                     TextAlignment="{Binding Editor.CellTypography.TextAlignment}"
                                     VerticalContentAlignment="{Binding Editor.CellTypography.VerticalAlignment}"
                                     Text="{Binding Editor.CellEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnCellEditorKeyDown" LostFocus="OnCellEditorLostFocus" />
                        </Canvas>
                        <!-- In-place primary-property editor (Text content / Barcode-QR value), over the element. -->
                        <Canvas IsHitTestVisible="{Binding Editor.IsPrimaryEditing}">
                            <TextBox x:Name="PrimaryEditor" IsVisible="{Binding Editor.IsPrimaryEditing}"
                                     Canvas.Left="{Binding Editor.PrimaryEditorRect.X}" Canvas.Top="{Binding Editor.PrimaryEditorRect.Y}"
                                     Width="{Binding Editor.PrimaryEditorRect.Width}" Height="{Binding Editor.PrimaryEditorRect.Height}"
                                     MinHeight="0" Padding="2,0" FontSize="{Binding Editor.PrimaryTypography.FontSize}"
                                     FontFamily="{Binding Editor.PrimaryTypography.FontFamily}"
                                     FontWeight="{Binding Editor.PrimaryTypography.FontWeight}"
                                     FontStyle="{Binding Editor.PrimaryTypography.FontStyle}"
                                     TextAlignment="{Binding Editor.PrimaryTypography.TextAlignment}"
                                     VerticalContentAlignment="{Binding Editor.PrimaryTypography.VerticalAlignment}"
                                     AcceptsReturn="{Binding Editor.PrimaryEditMultiline}"
                                     TextWrapping="Wrap"
                                     Text="{Binding Editor.PrimaryEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnPrimaryEditorKeyDown" LostFocus="OnPrimaryEditorLostFocus" />
                        </Canvas>
                    </Panel>
                </Border>
                </ScrollViewer>
                <!-- Print-area guide lines, spanning the canvas viewport; origin/scale synced in code-behind. -->
                <views:PrintGuideOverlay Grid.Row="1" Grid.Column="1" x:Name="PrintGuide"
                                         IsVisible="{Binding Editor.ShowWorkspaceGuides}"
                                         InsetXMm="{Binding Editor.PrintableInsetXMm}"
                                         InsetYMm="{Binding Editor.PrintableInsetYMm}"
                                         LabelWidthMm="{Binding Editor.CanvasWidthMm}"
                                         LabelHeightMm="{Binding Editor.CanvasHeightMm}" />

                <!-- Data-merge preview bar (GitHub #7.2): step through rows shown on the canvas. -->
                <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding DataMerge.IsPreviewing}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceBar}" BorderBrush="{DynamicResource SurfaceSplitter}"
                        BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{Binding DataMerge.PrevRowCommand}" Padding="4" ToolTip.Tip="Previous row">
                            <mi:MaterialIcon Kind="ChevronLeft" />
                        </Button>
                        <TextBlock Text="{Binding DataMerge.PreviewRowLabel}" VerticalAlignment="Center"
                                   MinWidth="90" TextAlignment="Center" />
                        <Button Command="{Binding DataMerge.NextRowCommand}" Padding="4" ToolTip.Tip="Next row">
                            <mi:MaterialIcon Kind="ChevronRight" />
                        </Button>
                        <Border Width="1" Background="{DynamicResource SurfaceSplitter}" Margin="2,0" />
                        <Button Command="{Binding DataMerge.ExitPreviewCommand}" Content="Close" Padding="6,2" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource SurfaceSplitter}" />

            <!-- RIGHT: inspector + printer tabs -->
            <TabControl IsEnabled="{Binding !Editor.IsBlockReadOnly}" x:Name="InspectorTabs" Grid.Column="4" Background="{DynamicResource SurfacePanel}">
                <TabItem Header="Properties">
                    <ScrollViewer Padding="8" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
                        <StackPanel>
                        <!-- Table cell controls (mirror the right-click cell menu) — shown in cell-edit mode. -->
                        <StackPanel IsVisible="{Binding InspectorShowsCells}" Spacing="3">
                            <TextBlock Text="Table" FontWeight="Bold" Margin="0,0,0,2" />
                            <Grid Classes="frow" ColumnDefinitions="70,*"><TextBlock Text="Cols" /><NumericUpDown Grid.Column="1" Value="{Binding Editor.((ed:TableEditorViewModel)SelectedEditor).Cols, Converter={StaticResource Nz}}" Minimum="1" FormatString="0" /></Grid>
                            <Grid Classes="frow" ColumnDefinitions="70,*"><TextBlock Text="Rows" /><NumericUpDown Grid.Column="1" Value="{Binding Editor.((ed:TableEditorViewModel)SelectedEditor).Rows, Converter={StaticResource Nz}}" Minimum="1" FormatString="0" /></Grid>
                            <TextBlock Classes="section" Text="Cell" />
                            <Grid Classes="frow" ColumnDefinitions="90,*">
                                <TextBlock Text="Font" />
                                <ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.CellFontItems}" SelectedValueBinding="{ReflectionBinding Content}" SelectedValue="{Binding Editor.CellFontFamily, Mode=OneWay}" Tag="cell" DropDownOpened="OnFontDropDownOpened" SelectionChanged="OnFontSelectionChanged" />
                            </Grid>
                            <Grid Classes="frow" ColumnDefinitions="90,*">
                                <TextBlock Text="Size pt" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Editor.CellFontSizePt, Converter={StaticResource Nz}}" Minimum="1" Maximum="500" Watermark="table default" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Merge" Command="{Binding CellMergeCommand}" />
                                <Button Content="Unmerge" Command="{Binding CellUnmergeCommand}" />
                            </StackPanel>
                            <TextBlock Classes="section" Text="Fill" />
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton Classes="icon" ToolTip.Tip="No fill" IsChecked="{Binding Editor.CellFill, Converter={StaticResource Eq}, ConverterParameter=0}"><Rectangle Width="16" Height="13" Fill="White" Stroke="#888" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="25%" IsChecked="{Binding Editor.CellFill, Converter={StaticResource Eq}, ConverterParameter=25}"><Rectangle Width="16" Height="13" Fill="#BFBFBF" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="50%" IsChecked="{Binding Editor.CellFill, Converter={StaticResource Eq}, ConverterParameter=50}"><Rectangle Width="16" Height="13" Fill="#808080" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="75%" IsChecked="{Binding Editor.CellFill, Converter={StaticResource Eq}, ConverterParameter=75}"><Rectangle Width="16" Height="13" Fill="#404040" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="100%" IsChecked="{Binding Editor.CellFill, Converter={StaticResource Eq}, ConverterParameter=100}"><Rectangle Width="16" Height="13" Fill="Black" /></ToggleButton>
                            </StackPanel>
                            <TextBlock Classes="section" Text="Text" />
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton Classes="icon" ToolTip.Tip="Black text" IsChecked="{Binding Editor.CellTextColor, Converter={StaticResource Eq}, ConverterParameter=black}"><Border Background="White" Padding="4,0"><TextBlock Text="A" Foreground="Black" /></Border></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="White text" IsChecked="{Binding Editor.CellTextColor, Converter={StaticResource Eq}, ConverterParameter=white}"><Border Background="Black" Padding="4,0"><TextBlock Text="A" Foreground="White" /></Border></ToggleButton>
                                <Rectangle Width="1" Fill="{DynamicResource DividerWeak}" Margin="3,2" />
                                <ToggleButton Classes="icon" ToolTip.Tip="Bold" IsChecked="{Binding Editor.CellBold}"><mi:MaterialIcon Kind="FormatBold" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="Italic" IsChecked="{Binding Editor.CellItalic}"><mi:MaterialIcon Kind="FormatItalic" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="Underline" IsChecked="{Binding Editor.CellUnderline}"><mi:MaterialIcon Kind="FormatUnderline" /></ToggleButton>
                            </StackPanel>
                            <TextBlock Classes="section" Text="Align" />
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton Classes="icon" ToolTip.Tip="Left" IsChecked="{Binding Editor.CellAlignH, Converter={StaticResource Eq}, ConverterParameter=left}"><mi:MaterialIcon Kind="FormatAlignLeft" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="Center" IsChecked="{Binding Editor.CellAlignH, Converter={StaticResource Eq}, ConverterParameter=center}"><mi:MaterialIcon Kind="FormatAlignCenter" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="Right" IsChecked="{Binding Editor.CellAlignH, Converter={StaticResource Eq}, ConverterParameter=right}"><mi:MaterialIcon Kind="FormatAlignRight" /></ToggleButton>
                                <Rectangle Width="1" Fill="{DynamicResource DividerWeak}" Margin="3,2" />
                                <ToggleButton Classes="icon" ToolTip.Tip="Top" IsChecked="{Binding Editor.CellAlignV, Converter={StaticResource Eq}, ConverterParameter=top}"><mi:MaterialIcon Kind="AlignVerticalTop" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="Middle" IsChecked="{Binding Editor.CellAlignV, Converter={StaticResource Eq}, ConverterParameter=middle}"><mi:MaterialIcon Kind="AlignVerticalCenter" /></ToggleButton>
                                <ToggleButton Classes="icon" ToolTip.Tip="Bottom" IsChecked="{Binding Editor.CellAlignV, Converter={StaticResource Eq}, ConverterParameter=bottom}"><mi:MaterialIcon Kind="AlignVerticalBottom" /></ToggleButton>
                            </StackPanel>
                            <views:TableBorderControls />
                            <TextBlock Classes="section" Text="Header" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton Content="Row" IsChecked="{Binding Editor.CellHeaderRow}" />
                                <ToggleButton Content="Column" IsChecked="{Binding Editor.CellHeaderColumn}" />
                            </StackPanel>
                            <TextBlock Text="Double-click a cell to edit · Esc to exit" Foreground="{DynamicResource TextHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Button Content="Apply format to all cells" Command="{Binding ApplyFormatToAllCellsCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            <Separator Margin="0,4" />
                        </StackPanel>
                        <ContentControl Name="InspectorHost" Content="{Binding Editor.InspectorTarget}"
                                        IsVisible="{Binding !InspectorShowsCells}">
                        <ContentControl.DataTemplates>

                            <DataTemplate DataType="ed:CanvasEditorViewModel">
                                <StackPanel Spacing="2" IsEnabled="{Binding !ReadOnlyContext}">
                                    <TextBlock Text="Design" FontWeight="Bold" Margin="0,0,0,4" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Name of this saved design, used as the file-name suggestion. This is not the physical label stock name and does not print."><TextBlock Text="Design name" /><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <TextBlock Classes="section" Text="Label format" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="The physical label stock name. Saved separately from the design name."><TextBlock Text="Stock name" /><Grid Grid.Column="1" ColumnDefinitions="*,Auto"><ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StockChoices}" SelectedItem="{Binding StockName}" PlaceholderText="Select label stock" /><Button Grid.Column="1" Content="Edit" Margin="5,0,0,0" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditDesignStockCommand}" ToolTip.Tip="Edit this design's saved stock, including shape and corners. No printer connection required." /></Grid></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Layout" /><ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LayoutChoices}" SelectedItem="{Binding Layout}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Physical label width in mm (the media's printable width). Usually set automatically from the loaded roll."><TextBlock Text="Width mm" /><NumericUpDown Grid.Column="1" Value="{Binding WidthMm, Converter={StaticResource Nz}}" Minimum="1" IsEnabled="False" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Physical label height in mm (the feed length). Usually set automatically from the loaded roll."><TextBlock Text="Height mm" /><NumericUpDown Grid.Column="1" Value="{Binding HeightMm, Converter={StaticResource Nz}}" Minimum="1" IsEnabled="False" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Label outline shape: rectangle, rounded rectangle, or circle. Used for the safe-area guide and round-label rendering."><TextBlock Text="Shape" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.CanvasShape}" SelectedItem="{Binding Shape}" IsEnabled="False" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Corner radius (mm) when Shape is rounded. 0 = square corners."><TextBlock Text="Corner mm" /><NumericUpDown Grid.Column="1" IsEnabled="False" Value="{Binding CornerRadiusMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" /></Grid>
                                    <TextBlock Classes="section" Text="Print settings" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Soft safe margin (mm) inset on every edge — a guide to keep content clear of this printer's skew/registration (e.g. the B4's ~1 mm). It's a guide only: nothing crops to it, you can place a control outside if you choose. 0 = off."><TextBlock Text="Margin mm" /><NumericUpDown Grid.Column="1" Value="{Binding SafeMarginMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" /></Grid>
                                    <TextBlock Text="Margin guide = your safe margin on all edges, floored at the printhead crop on the width axis. Guides only — nothing is cropped to the margin." Foreground="{DynamicResource TextHint}" FontSize="11" TextWrapping="Wrap" Margin="0,4" />
                                <Expander Header="Advanced print settings" IsExpanded="False"><StackPanel Spacing="2">
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Print orientation. Rotates the printed output 90/180/270° onto the physical label; the canvas reshapes to match. Same as the toolbar rotate buttons."><TextBlock Text="Orient°" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Orientation}" SelectedItem="{Binding OrientationDeg}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Print resolution (dots per inch). Seeded from the connected printer — 203 for most NIIMBOT models."><TextBlock Text="DPI" /><NumericUpDown Grid.Column="1" Value="{Binding Dpi, Converter={StaticResource Nz}}" Minimum="50" FormatString="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Bleed margin (mm) outside the label edge. The validator warns when content sits past it — used for deliberate over-print onto continuous media."><TextBlock Text="Bleed mm" /><NumericUpDown Grid.Column="1" Value="{Binding BleedMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="The printer's maximum print width (mm). Content wider than this is cropped at print (the printable-area guide shows the limit). Blank = auto from the connected printer."><TextBlock Text="Printhead W" /><NumericUpDown Grid.Column="1" Value="{Binding PrintheadWidthMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" Watermark="auto" /></Grid>
</StackPanel></Expander>
</StackPanel>

</DataTemplate>

                            <DataTemplate DataType="ed:TextEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />

                                    <TextBlock Classes="section" Text="Content" />
                                    <views:ExpandingTextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ToolTip.Tip="The text to print. Use {token} placeholders for data-merge fields; Enter adds a line break." />

                                    <TextBlock Classes="section" Text="Font" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Typeface. The list is the app's bundled fonts; an unavailable font falls back at render (flagged by the validator)."><TextBlock Text="Font" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.FontItems}" SelectedValueBinding="{ReflectionBinding Content}" SelectedValue="{Binding SelectedFont, Mode=OneWay}" Tag="text" DropDownOpened="OnFontDropDownOpened" SelectionChanged="OnFontSelectionChanged" /></Grid>
                                    <!-- Size + B/I/U share one row. -->
                                    <Grid Classes="frow" ColumnDefinitions="90,120,*">
                                        <TextBlock Text="Size (pt)" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding FontSizePt, Converter={StaticResource Nz}}" Minimum="1" Maximum="500" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                            <ToggleButton Classes="icon" ToolTip.Tip="Bold" IsChecked="{Binding Bold}"><mi:MaterialIcon Kind="FormatBold" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Italic" IsChecked="{Binding Italic}"><mi:MaterialIcon Kind="FormatItalic" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Underline" IsChecked="{Binding Underline}"><mi:MaterialIcon Kind="FormatUnderline" /></ToggleButton>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Classes="section" Text="Paragraph" />
                                    <CheckBox IsChecked="{Binding AutoSize}" Content="Auto-size box to text" Margin="0,2"
                                              ToolTip.Tip="The box hugs the text (no resize handles). Turn off for a fixed box with word-wrap." />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" IsEnabled="{Binding !AutoSize}" ToolTip.Tip="How text wraps in a fixed box: word, character, or none (single line, may clip). Disabled when Auto-size is on."><TextBlock Text="Wrap" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Wrap}" SelectedItem="{Binding Wrap}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Line-height multiplier for multi-line text. 1.0 = single spacing, 2.0 = double."><TextBlock Text="Line spacing" /><NumericUpDown Grid.Column="1" Value="{Binding LineSpacing, Converter={StaticResource Nz}}" Minimum="0" Increment="0.1" FormatString="0.0#" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Extra space between characters in points. Negative values condense text without changing font size; zero is normal."><TextBlock Text="Char spacing" /><NumericUpDown Grid.Column="1" Value="{Binding LetterSpacing, Converter={StaticResource Nz}}" Minimum="-10" Maximum="50" Increment="0.1" FormatString="0.0#" /></Grid>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:BarcodeEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Barcode symbology (Code128, EAN-13, …). Pick the one your scanner/system expects; some require a specific value length."><TextBlock Text="Symbology" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Symbology}" SelectedItem="{Binding Symbology}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="The data to encode in the barcode. Must be valid for the chosen symbology (e.g. EAN-13 needs 12–13 digits)."><TextBlock Text="Value" /><TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <CheckBox IsChecked="{Binding ShowText}" Content="Show text" Margin="0,4" ToolTip.Tip="Print the human-readable value beneath/above the bars." />
                                    <Grid IsEnabled="{Binding ShowText}" Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Where the human-readable text sits relative to the bars (above / below). Only used when Show text is on."><TextBlock Text="Text pos" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.TextPosition}" SelectedItem="{Binding TextPosition}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Width of the narrowest bar (the 'module'). Larger = a wider, more scannable barcode; too small may not scan."><TextBlock Text="Module mm" /><NumericUpDown Grid.Column="1" Value="{Binding ModuleWidthMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Quiet mm" ToolTip.Tip="Blank margin on each side of the barcode, required for reliable scanning." /><NumericUpDown Grid.Column="1" Value="{Binding QuietZoneMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" ToolTip.Tip="Blank margin on each side of the barcode, required for reliable scanning." /></Grid>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:BlockEditorViewModel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Linked custom block" FontWeight="Bold" />
                                    <TextBlock Text="Contents are read-only; move this block as one element. Parameter values belong to this design. Shared edits require deliberate unlocking." TextWrapping="Wrap" MaxWidth="260" />
                                    <Grid ColumnDefinitions="70,*"><TextBlock Text="Name" /><TextBox Grid.Column="1" Text="{Binding Name}" /></Grid>
                                    <Grid ColumnDefinitions="70,*"><TextBlock Text="X mm" /><NumericUpDown Grid.Column="1" Value="{Binding X}" Increment="0.1" /></Grid>
                                    <Grid ColumnDefinitions="70,*"><TextBlock Text="Y mm" /><NumericUpDown Grid.Column="1" Value="{Binding Y}" Increment="0.1" /></Grid>
                                    <Button Content="Unlock and edit block in place..." Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditBlockInPlaceCommand}" />
                                    <Button Content="Edit design parameter values..." Click="OnManageParameters" />
                                    <Button Content="Custom block library..." Click="OnManageCustomBlocks" />
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="ed:QrEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <TextBlock Text="Drag the blue handles to resize the code only. Caption size is controlled below." TextWrapping="Wrap" />
                                    <CheckBox Content="Keep QR square when resizing" IsChecked="{Binding LockAspect}" />
                                    <Button Content="Make square / Auto module size" Command="{Binding MakeSquareCommand}" />

                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="The data to encode in the QR code. Press Enter to add a new line; line breaks are included in the encoded value."><TextBlock Text="Value" /><views:ExpandingTextBox Grid.Column="1" MinHeight="48" MaxHeight="240" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Character encoding for the QR payload (e.g. UTF-8 / byte). Use the default unless the target reader needs a specific mode."><TextBlock Text="Encoding" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.QrEncoding}" SelectedItem="{Binding Encoding}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Error-correction level — higher recovers from more damage/smudging but makes the code denser. L≈7%, M≈15%, Q≈25%, H≈30%."><TextBlock Text="EC level" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.EcLevel}" SelectedItem="{Binding EcLevel}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Module mm" /><NumericUpDown Grid.Column="1" Value="{Binding ModuleSizeMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" Watermark="auto" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Quiet mm" ToolTip.Tip="Blank margin around the code, required for reliable scanning. The gap to the selection box is the quiet zone, not a bug; 0 hugs the box but can hurt scannability." /><NumericUpDown Grid.Column="1" Value="{Binding QuietZoneMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" ToolTip.Tip="Blank margin around the code, required for reliable scanning. 0 hugs the box but can hurt scannability." /></Grid>
                                    <TextBlock Classes="section" Text="Value caption" />
                                    <CheckBox Content="Show value" IsChecked="{Binding ShowText}" />
                                    <StackPanel Spacing="2" IsVisible="{Binding ShowText}">
                                        <TextBlock Text="Caption is outside the QR box. Alignment follows the code edges; Wrap = none allows text to extend sideways." TextWrapping="Wrap" />
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Position" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.QrTextPositions}" SelectedItem="{Binding TextPosition}" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Font" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.QrCaptionFontItems}" SelectedValueBinding="{ReflectionBinding Content}" SelectedValue="{Binding TextFontFamily, Mode=OneWay}" Tag="qr" DropDownOpened="OnFontDropDownOpened" SelectionChanged="OnFontSelectionChanged" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Alignment" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.QrTextAlignments}" SelectedItem="{Binding TextAlignment}" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Wrap" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Wrap}" SelectedItem="{Binding TextWrap}" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Size pt" /><NumericUpDown Grid.Column="1" Value="{Binding TextSizePt, Converter={StaticResource Nz}}" Minimum="1" Maximum="100" Increment="0.1" FormatString="0.0#" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Height mm" /><NumericUpDown Grid.Column="1" Value="{Binding TextHeightMm, Converter={StaticResource Nz}}" Minimum="0.1" Maximum="100" Increment="0.1" FormatString="0.0#" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Gap mm" /><NumericUpDown Grid.Column="1" Value="{Binding TextGapMm, Converter={StaticResource Nz}}" Minimum="0" Maximum="50" Increment="0.1" FormatString="0.0#" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Char spacing" /><NumericUpDown Grid.Column="1" Value="{Binding TextLetterSpacing, Converter={StaticResource Nz}}" Minimum="-10" Maximum="50" Increment="0.1" FormatString="0.0#" /></Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ToggleButton Classes="icon" ToolTip.Tip="Bold" IsChecked="{Binding TextBold}"><mi:MaterialIcon Kind="FormatBold" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Italic" IsChecked="{Binding TextItalic}"><mi:MaterialIcon Kind="FormatItalic" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Underline" IsChecked="{Binding TextUnderline}"><mi:MaterialIcon Kind="FormatUnderline" /></ToggleButton>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:SerialEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="First number in the run-numbering sequence."><TextBlock Text="Start" /><NumericUpDown Grid.Column="1" Value="{Binding Start, Converter={StaticResource Nz}}" Minimum="0" FormatString="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Increment between consecutive labels (1, 2, 3… by Step)."><TextBlock Text="Step" /><NumericUpDown Grid.Column="1" Value="{Binding Step, Converter={StaticResource Nz}}" Minimum="1" FormatString="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Pad the number to this many digits with the pad character (e.g. 4 → 0007). 0 = no padding."><TextBlock Text="Pad len" /><NumericUpDown Grid.Column="1" Value="{Binding PadLength, Converter={StaticResource Nz}}" Minimum="0" FormatString="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Character used to pad to Pad len (usually 0)."><TextBlock Text="Pad char" /><TextBox Grid.Column="1" Text="{Binding PadChar, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Fixed text placed before the number (e.g. 'SN-' → SN-0007)."><TextBlock Text="Prefix" /><TextBox Grid.Column="1" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Fixed text placed after the number."><TextBlock Text="Suffix" /><TextBox Grid.Column="1" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:DateTimeEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="What to show: date, time, or date+time."><TextBlock Text="Kind" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.DateKind}" SelectedItem="{Binding Kind}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Date/time format string (.NET): yyyy=year, MM=month, dd=day, HH=24h, mm=min. E.g. yyyy-MM-dd or dd MMM yyyy."><TextBlock Text="Format" /><TextBox Grid.Column="1" Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="printNow = stamped with the date/time at print; fixed = use the Fixed value below."><TextBlock Text="Source" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.DateSource}" SelectedItem="{Binding Source}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="The date/time to use when Source = fixed (ISO-8601 UTC, e.g. 2026-06-15T00:00:00Z). Ignored when Source = printNow."><TextBlock Text="Fixed value" /><TextBox Grid.Column="1" Text="{Binding FixedValueUtc, UpdateSourceTrigger=PropertyChanged}" Watermark="ISO-8601 UTC" /></Grid>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:ShapeEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Shape to draw: rectangle, rounded rectangle, ellipse, or line."><TextBlock Text="Shape" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.ShapeType}" SelectedItem="{Binding ShapeType}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Outline thickness in mm. 0 = no outline (use Fill = solid for a filled shape)."><TextBlock Text="Stroke mm" /><NumericUpDown Grid.Column="1" Value="{Binding StrokeWidthMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="none = outline only; solid = filled black."><TextBlock Text="Fill" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Fill}" SelectedItem="{Binding Fill}" /></Grid>
                                    <Grid IsEnabled="{Binding ShapeType, Converter={StaticResource Eq}, ConverterParameter=roundedRect}" Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Corner radius (mm) for a rounded rectangle. 0 = sharp corners. Ignored for ellipse."><TextBlock Text="Corner mm" /><NumericUpDown Grid.Column="1" Value="{Binding CornerRadiusMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" /></Grid>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:LineEditorViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Line" FontWeight="Bold" Margin="0,0,0,2" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="This element's name — shown in the Elements list. Doesn't print."><TextBlock Text="Name" /><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /></Grid>

                                    <TextBlock Classes="section" Text="Endpoints" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*,22,*" Margin="0,1" ToolTip.Tip="Start point of the line — X and Y in mm from the label's top-left. Or drag the endpoint handle on the canvas.">
                                        <TextBlock Text="Point 1" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding P1X, Converter={StaticResource Nz}}" FormatString="0.#" Increment="0.5" />
                                        <TextBlock Grid.Column="2" Text="Y" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                        <NumericUpDown Grid.Column="3" Value="{Binding P1Y, Converter={StaticResource Nz}}" FormatString="0.#" Increment="0.5" />
                                    </Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*,22,*" Margin="0,1" ToolTip.Tip="End point of the line — X and Y in mm from the label's top-left.">
                                        <TextBlock Text="Point 2" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding P2X, Converter={StaticResource Nz}}" FormatString="0.#" Increment="0.5" />
                                        <TextBlock Grid.Column="2" Text="Y" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                        <NumericUpDown Grid.Column="3" Value="{Binding P2Y, Converter={StaticResource Nz}}" FormatString="0.#" Increment="0.5" />
                                    </Grid>

                                    <TextBlock Classes="section" Text="Style" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Line thickness (stroke weight) in mm."><TextBlock Text="Weight mm" /><NumericUpDown Grid.Column="1" Value="{Binding WeightMm, Converter={StaticResource Nz}}" Increment="0.1" Minimum="0" FormatString="0.0#" /></Grid>

                                    <TextBlock Classes="section" Text="Form alignment" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Center H" ToolTip.Tip="Center horizontally on the label"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CenterOnLabelHCommand}" />
                                        <Button Content="Center V" ToolTip.Tip="Center vertically on the label"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CenterOnLabelVCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:ImageEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <Button HorizontalAlignment="Stretch" Margin="0,2"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChooseImageCommand}"
                                            Content="Choose image…" />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="The packaged image asset this element draws. Set by 'Choose image…'; rarely edited by hand."><TextBlock Text="Asset id" /><TextBox Grid.Column="1" Text="{Binding AssetId, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="How the image fills its box: fill (cover, may crop), fit (whole image, may letterbox), stretch (distort to box), center (no scale)."><TextBlock Text="Fit" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Fit}" SelectedItem="{Binding Fit}" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="How the image is reduced to 1-bit black/white for the thermal head: threshold = hard cut; Floyd–Steinberg / Atkinson / ordered = dot patterns that fake grey shading."><TextBlock Text="Dither" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.Dither}" SelectedItem="{Binding Dither}" /></Grid>
                                    <Grid IsEnabled="{Binding Dither, Converter={StaticResource Eq}, ConverterParameter=threshold}" Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Black/white cutoff (0–255), used only when Dither = threshold. Lower = more pixels turn black."><TextBlock Text="Threshold" /><NumericUpDown Grid.Column="1" Value="{Binding Threshold, Converter={StaticResource Nz}}" Minimum="0" Maximum="255" FormatString="0" /></Grid>
                                    <CheckBox IsChecked="{Binding Invert}" Content="Invert" Margin="0,4" ToolTip.Tip="Swap black and white in the output." />
                                    <TextBlock Text="Transform" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Classes="icon" Command="{Binding RotateCcwCommand}" ToolTip.Tip="Rotate counter-clockwise 90°"><mi:MaterialIcon Kind="RotateLeft" /></Button>
                                        <Button Classes="icon" Command="{Binding RotateCwCommand}" ToolTip.Tip="Rotate clockwise 90°"><mi:MaterialIcon Kind="RotateRight" /></Button>
                                        <ToggleButton Classes="icon" IsChecked="{Binding FlipH}" ToolTip.Tip="Mirror (flip horizontal)"><mi:MaterialIcon Kind="FlipHorizontal" /></ToggleButton>
                                        <ToggleButton Classes="icon" IsChecked="{Binding FlipV}" ToolTip.Tip="Flip (vertical)"><mi:MaterialIcon Kind="FlipVertical" /></ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="ed:TableEditorViewModel">
                                <StackPanel Spacing="2">
                                    <views:BaseElementFields />
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Number of columns. Changing it adds/removes columns from the right."><TextBlock Text="Cols" /><NumericUpDown Grid.Column="1" Value="{Binding Cols, Converter={StaticResource Nz}}" Minimum="1" FormatString="0" /></Grid>
                                    <Grid Classes="frow" ColumnDefinitions="90,*" ToolTip.Tip="Number of rows. Changing it adds/removes rows from the bottom."><TextBlock Text="Rows" /><NumericUpDown Grid.Column="1" Value="{Binding Rows, Converter={StaticResource Nz}}" Minimum="1" FormatString="0" /></Grid>
                                    <StackPanel DataContext="{Binding $parent[Window].DataContext}" x:DataType="vm:MainWindowViewModel" Spacing="4">
                                        <TextBlock Classes="section" Text="Text — whole table" />
                                        <TextBlock Text="Changes below apply to every cell." FontSize="11" Foreground="{DynamicResource TextHint}" />
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Font" /><ComboBox Classes="fld" Grid.Column="1" ItemsSource="{x:Static ed:EditorOptions.CellFontItems}" SelectedValueBinding="{ReflectionBinding Content}" SelectedValue="{Binding Editor.CellFontFamily, Mode=OneWay}" Tag="cell" DropDownOpened="OnFontDropDownOpened" SelectionChanged="OnFontSelectionChanged" /></Grid>
                                        <Grid Classes="frow" ColumnDefinitions="90,*"><TextBlock Text="Size pt" /><NumericUpDown Grid.Column="1" Value="{Binding Editor.CellFontSizePt, Converter={StaticResource Nz}}" Minimum="1" Maximum="500" Watermark="table default" /></Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <ToggleButton Classes="icon" ToolTip.Tip="Bold" IsChecked="{Binding Editor.CellBold}"><mi:MaterialIcon Kind="FormatBold" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Italic" IsChecked="{Binding Editor.CellItalic}"><mi:MaterialIcon Kind="FormatItalic" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Underline" IsChecked="{Binding Editor.CellUnderline}"><mi:MaterialIcon Kind="FormatUnderline" /></ToggleButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <ToggleButton Classes="icon" ToolTip.Tip="Align left" IsChecked="{Binding Editor.CellAlignH, Converter={StaticResource Eq}, ConverterParameter=left}"><mi:MaterialIcon Kind="FormatAlignLeft" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Align centre" IsChecked="{Binding Editor.CellAlignH, Converter={StaticResource Eq}, ConverterParameter=center}"><mi:MaterialIcon Kind="FormatAlignCenter" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Align right" IsChecked="{Binding Editor.CellAlignH, Converter={StaticResource Eq}, ConverterParameter=right}"><mi:MaterialIcon Kind="FormatAlignRight" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Align top" IsChecked="{Binding Editor.CellAlignV, Converter={StaticResource Eq}, ConverterParameter=top}"><mi:MaterialIcon Kind="AlignVerticalTop" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Align middle" IsChecked="{Binding Editor.CellAlignV, Converter={StaticResource Eq}, ConverterParameter=middle}"><mi:MaterialIcon Kind="AlignVerticalCenter" /></ToggleButton>
                                            <ToggleButton Classes="icon" ToolTip.Tip="Align bottom" IsChecked="{Binding Editor.CellAlignV, Converter={StaticResource Eq}, ConverterParameter=bottom}"><mi:MaterialIcon Kind="AlignVerticalBottom" /></ToggleButton>
                                        </StackPanel>
                                        <views:TableBorderControls />
                                    </StackPanel>                                    <TextBlock Text="Double-click the table to edit cells (select, type, merge, fill, header)."
                                               Foreground="{DynamicResource TextHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6" />
                                </StackPanel>
                            </DataTemplate>

                            </ContentControl.DataTemplates>
                        </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Printer">
                    <ScrollViewer Padding="8" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Printer}">
                        <StackPanel Spacing="6">
                            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />
                            <TextBlock Text="Connection" FontWeight="Bold" Foreground="{DynamicResource TextStrong}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Ports}"
                                      SelectedItem="{Binding SelectedPort}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PortItem">
                                        <TextBlock Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Scan" Command="{Binding RefreshPortsCommand}" />
                                <Button Content="Connect" Command="{Binding ConnectCommand}" />
                                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConnectionInfo, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />

                            <Separator />
                            <TextBlock Text="Status" FontWeight="Bold" Foreground="{DynamicResource TextStrong}" />
                            <TextBlock Text="{Binding StatusInfo, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Refresh status" Command="{Binding RefreshStatusCommand}" />
                                <Button Content="Change labels" Command="{Binding ChangeLabelsCommand}"
                                        ToolTip.Tip="Re-read the roll after swapping labels" />
                            </StackPanel>

                            <!-- Matched roll (GitHub #18): a known barcode is applied without a dialog, so
                                 this is the only place the user can see what was matched and fix it. -->
                            <Border IsVisible="{Binding HasMatchedRoll}" Margin="0,4,0,0" Padding="8,6"
                                    CornerRadius="3" Background="{DynamicResource SurfaceBar}"
                                    BorderThickness="1" BorderBrush="{DynamicResource DividerWeak}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Matched roll" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding MatchedRollName}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextStrong}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MatchedRollDetail}"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Edit" VerticalAlignment="Center"
                                            Command="{Binding EditMatchedRollCommand}"
                                            ToolTip.Tip="Review or correct this roll's saved definition" />
                                </Grid>
                            </Border>

                            <Separator />
                            <TextBlock Text="Print" FontWeight="Bold" Foreground="{DynamicResource TextStrong}" />
                            <Grid ColumnDefinitions="90,*" Margin="0,2">
                                <TextBlock Text="Density" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Slider Width="150" Minimum="{Binding DensityMin}" Maximum="{Binding DensityMax}"
                                            Value="{Binding Density}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                    <TextBlock Text="{Binding Density, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Grid>
                            <Expander Header="Advanced media settings" IsExpanded="False"><StackPanel><CheckBox Content="Override stock media mode" IsChecked="{Binding AllowMediaOverride}" />
<Grid ColumnDefinitions="90,*" Margin="0,2">
                                <TextBlock Text="Media mode" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding AllowMediaOverride}" ItemsSource="{Binding LabelTypes}" SelectedItem="{Binding SelectedLabelType}" />
                            </Grid>
</StackPanel></Expander>
                            <Grid ColumnDefinitions="90,*" Margin="0,2">
                                <TextBlock Text="Copies" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="CopiesInput" Grid.Column="1" Value="{Binding Copies, Converter={StaticResource Nz}}" Minimum="1" FormatString="0" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*" Margin="0,2">
                                <TextBlock Text="Offset X px" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding OffsetX, Converter={StaticResource Nz}}" FormatString="0" />
                            </Grid>
                            <Grid ColumnDefinitions="90,*" Margin="0,2">
                                <TextBlock Text="Offset Y px" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding OffsetY, Converter={StaticResource Nz}}" FormatString="0" />
                            </Grid>
                            <Button Content="{Binding PrintButtonText}" Command="{Binding PrintButtonCommand}" HorizontalAlignment="Stretch" Margin="0,6" />

                            <TextBlock Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource TextInfo}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

    </DockPanel>

</Window>
