<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Thermalith.App.ViewModels"
        xmlns:ed="clr-namespace:Thermalith.App.ViewModels.Editors"
        x:Class="Thermalith.App.Views.RollDialog"
        x:DataType="vm:RollDialogViewModel"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Grid.r">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style Selector="Grid.r > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="18" Spacing="2">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

        <Border IsVisible="{Binding HasRfid}" Background="#22000000" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
            <StackPanel Spacing="2">
                <TextBlock Text="Roll detected (RFID)" Foreground="{DynamicResource TextInfo}" FontSize="11" />
                <TextBlock Text="{Binding RfidSummary}" Foreground="{DynamicResource TextPrimary}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding IsNewDesign}" Spacing="5" Margin="0,0,0,12">
            <TextBlock Classes="section" Text="Design" />
            <Grid Classes="r" ColumnDefinitions="92,*" ToolTip.Tip="Name of the artwork/template you are creating."><TextBlock Text="Design name" /><TextBox Grid.Column="1" Text="{Binding DesignName}" /></Grid>
        </StackPanel>
        <Grid Classes="r" ColumnDefinitions="92,*" IsVisible="{Binding IsNewDesign}"><TextBlock Text="Stock" /><ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding StockChoices}" SelectedIndex="{Binding SelectedStockIndex}" /></Grid>
        <Grid Classes="r" ColumnDefinitions="92,*" IsVisible="{Binding IsNewDesign}"><TextBlock Text="Layout" /><ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LayoutChoices}" SelectedItem="{Binding Layout}" /></Grid>
        <TextBlock Classes="section" Text="Label stock" />
        <Grid Classes="r" ColumnDefinitions="92,*" ToolTip.Tip="Name of the physical label stock, for example Transparent 80 × 50."><TextBlock Text="Stock name" /><TextBox Grid.Column="1" Text="{Binding Name}" /></Grid>
        <Grid Classes="r" ColumnDefinitions="92,*"><TextBlock Text="Part name" /><TextBox Grid.Column="1" Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" Watermark="e.g. T40*20-320WHITE" /></Grid>
        <Grid Classes="r" ColumnDefinitions="92,*"><TextBlock Text="Box id" /><TextBox Grid.Column="1" Text="{Binding BoxId}" Watermark="optional, e.g. 30486" /></Grid>
        <Grid Classes="r" ColumnDefinitions="92,*"><TextBlock Text="Paper type" /><ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static ed:EditorOptions.PaperType}" SelectedItem="{Binding PaperType}" /></Grid>
        <Grid ColumnDefinitions="92,*,Auto,*" Margin="0,3">
            <TextBlock Text="Width mm" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource Num}}" />
            <TextBlock Grid.Column="2" Text="Height" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,6,0" />
            <TextBox Grid.Column="3" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource Num}}" />
        </Grid>
        <Grid Classes="r" ColumnDefinitions="92,*"><TextBlock Text="Shape" /><ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static ed:EditorOptions.CanvasShape}" SelectedItem="{Binding Shape}" /></Grid>
        <Grid Classes="r" ColumnDefinitions="92,*" ToolTip.Tip="Physical corner radius for rounded labels. Measure the roll; existing rounded rolls default to 2 mm."><TextBlock Text="Corner mm" /><NumericUpDown Grid.Column="1" Value="{Binding CornerRadiusMm}" Minimum="0" Increment="0.1" /></Grid>
        <Grid Classes="r" ColumnDefinitions="92,*"><TextBlock Text="Density" /><TextBox Grid.Column="1" Text="{Binding Density, Converter={StaticResource Num}}" Watermark="optional" /></Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel" MinWidth="80" />
            <Button Content="{Binding SaveButtonText}" Click="OnSave" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
